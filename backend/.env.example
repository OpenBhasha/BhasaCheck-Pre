# Node/Express API + BullMQ worker. Copy to backend/.env.
# Never commit the real backend/.env file.

NODE_ENV=development
PORT=5000

# --- MongoDB ---
# In docker-compose this is overridden to mongodb://mongo:27017/rsml automatically.
MONGODB_URI=mongodb://localhost:27017/rsml

# --- Auth ---
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (one of two audio storage backends — see below) ---
# Same account/credentials as ml-service/.env — the ML service uploads
# processed audio to the same Cloudinary account Node reads from.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Local disk (the other audio storage backend) ---
# Chosen per upload via the `storageProvider` field ("cloudinary" | "local")
# — see POST /api/tasks in API_TESTING.md. Served back out at
# <PUBLIC_BASE_URL>/uploads/<path>, publicly reachable but at an unguessable
# path, the same security model a Cloudinary URL already has.
LOCAL_STORAGE_ROOT=./storage/audio
# Must be the URL this server is actually reachable at (the frontend browser
# and, in docker-compose, other containers both need to fetch local files
# through it) — overridden to http://backend:5000 automatically in compose.
PUBLIC_BASE_URL=http://localhost:5000
# Which backend an upload uses when the client doesn't specify one. Leave
# unset to auto-pick: "cloudinary" if CLOUDINARY_CLOUD_NAME is set, else
# "local" — so the app works with zero external setup out of the box.
DEFAULT_AUDIO_STORAGE_PROVIDER=

# --- Redis / BullMQ ---
# In docker-compose this is overridden to redis://redis:6379 automatically.
REDIS_URL=redis://localhost:6379

# --- Node -> Python ML service ---
# In docker-compose this is overridden to http://ml-service:8000 automatically.
ML_SERVICE_URL=http://localhost:8000
# Shared secret, must match ml-service/.env's INTERNAL_SERVICE_SECRET exactly:
# guards Node -> ML service requests AND the ML service's stage callbacks
# back into Node's /api/internal routes.
INTERNAL_SERVICE_SECRET=change-me-internal-secret
# Base URL the ML service uses to call back into Node with per-stage
# progress. In docker-compose this is overridden to http://backend:5000
# automatically; for local (non-Docker) dev this must be reachable from
# wherever the ml-service process is running.
INTERNAL_CALLBACK_URL=http://localhost:5000

# --- Uploads ---
MAX_AUDIO_FILE_SIZE_MB=200
ALLOWED_AUDIO_FORMATS=wav,mp3,m4a,flac,ogg

CORS_ORIGIN=*
