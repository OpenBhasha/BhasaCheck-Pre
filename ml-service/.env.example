# Python FastAPI ML preprocessing service. Copy to ml-service/.env.
# Never commit the real ml-service/.env file.

# --- Shared with the Node backend (must match backend/.env exactly) ---
# Guards incoming requests from Node AND is used when this service posts
# stage-progress callbacks back into Node's /api/internal routes.
INTERNAL_SERVICE_SECRET=change-me-internal-secret

# --- Cloudinary (audio storage) ---
# Same account/credentials as backend/.env — this service downloads the
# original upload and uploads the processed (post-Demucs) track here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Runtime ---
ML_WORK_DIR=/tmp/rsml-ml
ML_DEVICE=cpu

# --- Models ---
DEMUCS_MODEL=htdemucs
WHISPER_MODEL=small
PYANNOTE_PIPELINE=pyannote/speaker-diarization-community-1
# Required for the pyannote diarization pipeline (gated model card on Hugging Face).
HUGGINGFACE_TOKEN=

# Optional — only needed to enable the IndicConformer / NeMo transcription
# providers. Leave blank to route all transcription through Whisper.
INDIC_CONFORMER_MODEL_PATH=
NEMO_MODEL_PATH=
